# ── Foundry VTT system .gitignore ──────────────────────────────────────────

# OS
.DS_Store
Thumbs.db
*.swp
*~

# Node / build artefacts (if ever added)
node_modules/
dist/
.env

# Foundry local cache / temp files
*.lock
.fvtt-*/

# LevelDB lock files — created at runtime, must not be shipped in the zip
**/LOCK

# Compiled / minified outputs (keep source only)
*.min.js
*.min.css

# Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Test output
coverage/
